# LLM 深度解读配置（OpenAI 兼容接口）。复制本文件为 llm.env 并填入密钥后生效。
# llm.env 已被 .gitignore 忽略，不会提交到仓库。

# DeepSeek 示例（默认）：
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在此填入你的密钥
LLM_MODEL=deepseek-chat

# Kimi（Moonshot）示例：
# LLM_BASE_URL=https://api.moonshot.cn
# LLM_MODEL=kimi-k2-0905-preview

# 通义千问（DashScope 兼容模式）示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# LLM_MODEL=qwen-plus

# 可选：请求超时秒数
LLM_TIMEOUT=30
